{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://directsoundrecords.com/specifications/dsr-vpf/v1.0/dsr-vpf.schema.json",
  "title": "DSR Vinyl Playback Fingerprint record schema",
  "description": "Core machine-readable schema for DSR-VPF v1.0 fingerprint records.",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "fingerprint_id",
    "measurement_id",
    "method",
    "profile",
    "projection",
    "declared_measurand",
    "dimensions"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_name": {"const": "DSR-VPF"},
    "schema_version": {"const": "1.0"},
    "fingerprint_id": {"type": "string", "minLength": 1},
    "measurement_id": {"type": "string", "minLength": 1},
    "record_version": {"type": "string"},
    "publication_status": {"enum": ["draft", "published", "superseded", "withdrawn"]},
    "created_at": {"type": "string"},
    "method": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "DSR-VPF"},
        "version": {"const": "1.0"}
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "projection": {
      "type": "object",
      "required": ["id", "version", "axis_order"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"},
        "axis_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "declared_measurand": {"type": "string"},
    "comparison_class_eligibility": {
      "type": "array",
      "items": {"enum": ["A", "B", "C", "D"]},
      "uniqueItems": true
    },
    "measurement_context": {"type": "object"},
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "raw_value", "unit", "quality", "admissibility_weight", "profile_weight", "transformed_value"],
        "properties": {
          "id": {"type": "string"},
          "raw_quantity": {"type": "string"},
          "raw_value": {"type": ["number", "null"]},
          "unit": {"type": ["string", "null"]},
          "sign_convention": {"type": ["string", "null"]},
          "estimator": {"type": ["string", "null"]},
          "quality": {
            "enum": ["primary_valid", "supporting_valid", "diagnostic_only", "variable_or_unreliable", "unavailable"]
          },
          "admissibility_weight": {"type": "number", "minimum": 0, "maximum": 1},
          "profile_weight": {"type": "number", "exclusiveMinimum": 0},
          "transformed_value": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "analysis_method_version": {"type": ["string", "null"]},
          "validity": {"type": "object"},
          "repeatability_or_uncertainty": {"type": "object"},
          "limitation": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "comparison": {"type": "object"},
    "provenance": {"type": "object"},
    "licence": {"const": "CC-BY-4.0"}
  },
  "additionalProperties": true
}
